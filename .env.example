NODE_ENV=production
PORT=3000
APP_URL=https://permits.example.com
DATABASE_PATH=/data/permit-finder.sqlite
ADMIN_EMAIL=owner@example.com
# Set a unique password of at least 16 characters before first startup.
ADMIN_PASSWORD=
COMPANY_NAME=H&M Brothers Insulation
TRUST_PROXY=1
# Native non-AI collector: daily at 08:00 in America/New_York.
ENABLE_SCHEDULER=1
SCAN_TIMEZONE=America/New_York
DOMAIN=permits.example.com
